name: TasiaSL - Windows

on:
  push:
    branches:
      - tasia_windows_sl

  workflow_dispatch:
    inputs:
      publish_release:
        description: "Publish GitHub pre-release"
        required: true
        default: "false"
        type: choice
        options:
          - "false"
          - "true"

permissions:
  contents: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  AUTOBUILD_ADDRSIZE: 64
  AUTOBUILD_BUILD_ID: ${{ github.run_id }}
  AUTOBUILD_INSTALLABLE_CACHE: ${{ github.workspace }}/.autobuild-installables
  AUTOBUILD_VARIABLES_FILE: ${{ github.workspace }}/.build-variables/variables
  AUTOBUILD_VCS_INFO: "true"
  AUTOBUILD_VSVER: 170
  LL_SKIP_REQUIRE_SYSROOT: 1
  XZ_DEFAULTS: "-T0"

jobs:
  build:
    name: Build Tasia Viewer - Windows - FMOD
    runs-on: windows-2022
    timeout-minutes: 240

    steps:
      - name: Checkout viewer source
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"

      - name: Restore autobuild installables cache
        id: cache-autobuild
        uses: actions/cache@v4
        with:
          path: ${{ env.AUTOBUILD_INSTALLABLE_CACHE }}
          key: autobuild-windows-${{ hashFiles('autobuild.xml') }}
          restore-keys: |
            autobuild-windows-

      - name: Install autobuild and Python deps
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt

      - name: Checkout build variables
        uses: actions/checkout@v4
        with:
          repository: FirestormViewer/fs-build-variables
          path: .build-variables

      - name: Remove KDU
        shell: bash
        run: |
          set -euo pipefail
          autobuild installables remove kdu || true
          echo "KDU installable removed."

      - name: Download private FMOD autobuild package
        shell: bash
        env:
          GH_TOKEN: ${{ secrets.FMOD_DEPS_TOKEN }}
        run: |
          set -euo pipefail

          if [ -z "${GH_TOKEN:-}" ]; then
            echo "::error::FMOD_DEPS_TOKEN secret is missing."
            echo "::error::Create a read-only token that can download release assets from martysl/tasia-private-deps."
            exit 1
          fi

          mkdir -p private-deps

          FMOD_PLATFORM="windows64"
          FMOD_PATTERN="*windows64*.tar.bz2"

          echo "FMOD_PLATFORM=$FMOD_PLATFORM" >> "$GITHUB_ENV"

          echo "::group::Downloading FMOD package"
          echo "Pattern: $FMOD_PATTERN"

          gh release download fmod-20307 \
            --repo martysl/tasia-private-deps \
            --pattern "$FMOD_PATTERN" \
            --dir private-deps \
            --clobber

          echo "::endgroup::"

          FMOD_PACKAGE="$(find private-deps -type f -name '*.tar.bz2' | sort | head -n 1)"

          if [ -z "$FMOD_PACKAGE" ]; then
            echo "::error::FMOD Windows autobuild package was not downloaded."
            echo "::error::Expected pattern: $FMOD_PATTERN"
            echo "::error::Check repo: martysl/tasia-private-deps"
            echo "::error::Check release tag: fmod-20307"
            exit 1
          fi

          echo "Using FMOD package: $FMOD_PACKAGE"

          FMOD_HASH="$(python -c 'import hashlib, sys; print(hashlib.md5(open(sys.argv[1], "rb").read()).hexdigest())' "$FMOD_PACKAGE")"
          FMOD_FILE_URL="$(python -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$FMOD_PACKAGE")"

          echo "FMOD_PACKAGE=$FMOD_PACKAGE" >> "$GITHUB_ENV"
          echo "FMOD_HASH=$FMOD_HASH" >> "$GITHUB_ENV"
          echo "FMOD_FILE_URL=$FMOD_FILE_URL" >> "$GITHUB_ENV"

          echo "FMOD package ready: $FMOD_FILE_URL"
          echo "FMOD MD5: $FMOD_HASH"

      - name: Point autobuild to private FMOD package
        shell: bash
        run: |
          set -euo pipefail

          autobuild installables edit fmodstudio \
            platform="$FMOD_PLATFORM" \
            hash="$FMOD_HASH" \
            url="$FMOD_FILE_URL"

      - name: Load autobuild environment
        shell: bash
        run: |
          set -euo pipefail

          autobuild source_environment > .source_env
          . .source_env

          echo "LL_BUILD=${LL_BUILD:-}" >> "$GITHUB_ENV"
          echo "LL_BUILD_RELEASE=${LL_BUILD_RELEASE:-}" >> "$GITHUB_ENV"

      - name: Setup MSVC dev environment
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64
          vsversion: 2022

      - name: Install Windows build prerequisites
        shell: bash
        run: |
          set -euo pipefail

          choco install ninja --no-progress -y || true

          ninja --version
          cmake --version
          cmd.exe /c "where cl"

      - name: Install NASM for quictls/OpenSSL assembly optimization
        shell: bash
        run: |
          set -euo pipefail

          NASM_URL="https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/win64/nasm-2.16.03-win64.zip"
          NASM_ROOT_POSIX="/c/tools/nasm"

          rm -rf "$NASM_ROOT_POSIX"
          mkdir -p "$NASM_ROOT_POSIX"

          curl -fsSL -o /tmp/nasm.zip "$NASM_URL"

          NASM_ZIP_WIN="$(cygpath -w /tmp/nasm.zip)"

          powershell -NoLogo -NoProfile -Command \
            "Expand-Archive -LiteralPath '$NASM_ZIP_WIN' -DestinationPath 'C:\\tools\\nasm' -Force"

          NASM_DIR_POSIX="$(dirname "$(find "$NASM_ROOT_POSIX" -name nasm.exe -type f | sort | head -n 1)")"

          if [ -z "$NASM_DIR_POSIX" ]; then
            echo "::warning::NASM not available, continuing"
            exit 0
          fi

          NASM_DIR_WIN="$(cygpath -w "$NASM_DIR_POSIX")"

          echo "$NASM_DIR_WIN" >> "$GITHUB_PATH"
          echo "NASM_DIR=$NASM_DIR_POSIX" >> "$GITHUB_ENV"

          "$NASM_DIR_POSIX/nasm.exe" -v

      - name: Set up Strawberry Perl and NASM for MsQuic/quictls
        shell: bash
        run: |
          set -euo pipefail

          echo "C:/Strawberry/perl/bin" >> "$GITHUB_PATH"
          echo "C:/Strawberry/c/bin" >> "$GITHUB_PATH"

          export PATH="/c/Strawberry/perl/bin:/c/Strawberry/c/bin:$PATH"

          echo "Perl: $(perl -v | head -n 1)"
          perl -MLocale::Maketext::Simple -e "print qq(Locale::Maketext::Simple ok\n)"

          echo "NASM: $(command -v nasm)"
          nasm -v

      - name: Set Tasia build metadata
        shell: bash
        run: |
          set -euo pipefail

          TASIA_SHORT_SHA="${GITHUB_SHA::7}"

          echo "revision=${GITHUB_RUN_NUMBER}" >> "$GITHUB_ENV"
          echo "VIEWER_VERSION_GITHASH=${GITHUB_SHA}" >> "$GITHUB_ENV"
          echo "TASIA_SHORT_SHA=$TASIA_SHORT_SHA" >> "$GITHUB_ENV"
          echo "TASIA_DISPLAY_VERSION=8.0.1.${GITHUB_RUN_NUMBER}" >> "$GITHUB_ENV"
          echo "TASIA_BUILD_NUMBER=${GITHUB_RUN_NUMBER}" >> "$GITHUB_ENV"

      - name: Configure Windows with FMOD
        shell: bash
        env:
          TASIA_GIPHY_API_KEY: ${{ secrets.TASIA_GIPHY_API_KEY }}
          TASIA_KLIPY_API_KEY: ${{ secrets.TASIA_KLIPY_API_KEY }}
        run: |
          set -euo pipefail

          unset CC || true
          unset CXX || true

          export PATH="/c/Strawberry/perl/bin:/c/Strawberry/c/bin:$PATH"

          for edition in Enterprise Professional Community BuildTools; do
            VS_CMAKE_DIR="/c/Program Files/Microsoft Visual Studio/2022/${edition}/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin"
            if [ -f "$VS_CMAKE_DIR/cmake.exe" ]; then
              echo "Using VS-bundled CMake from: $VS_CMAKE_DIR"
              export PATH="$VS_CMAKE_DIR:$PATH"
              break
            fi
          done

          LOCAL_DIST_DIR_POSIX="$(pwd)/build-vc170-64/newview/unpacked"
          LOCAL_DIST_DIR="$(cygpath -m "$LOCAL_DIST_DIR_POSIX")"

          mkdir -p "$LOCAL_DIST_DIR_POSIX"

          autobuild configure \
            -c ReleaseFS_open \
            -A "${AUTOBUILD_ADDRSIZE}" \
            -- \
            --fmodstudio \
            --no-package \
            --ninja \
            "-DLOCAL_DIST_DIR:PATH=$LOCAL_DIST_DIR"

      - name: Build Windows with FMOD
        shell: bash
        run: |
          set -euo pipefail

          export PATH="/c/Strawberry/perl/bin:/c/Strawberry/c/bin:$PATH"

          command -v perl || true
          command -v nasm || echo "::warning::NASM not found"

          autobuild build \
            -c ReleaseFS_open \
            -A "${AUTOBUILD_ADDRSIZE}" \
            --no-configure \
            -- \
            --fmodstudio \
            --no-package \
            --ninja

      - name: Create Windows ZIP artifact
        shell: bash
        run: |
          set -euo pipefail

          python - <<'PY'
          import shutil
          from pathlib import Path

          dist = Path("build-vc170-64/newview/unpacked")

          if not dist.is_dir():
              raise SystemExit(f"Missing unpacked Windows dist: {dist}")

          archive = shutil.make_archive("Tasia-Viewer-Windows-FMOD", "zip", dist)
          print(f"Created {archive}")
          PY

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: Tasia-Viewer-Windows-FMOD-SL
          if-no-files-found: error
          path: Tasia-Viewer-Windows-FMOD.zip

      - name: Publish GitHub pre-release
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.publish_release == 'true' }}
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail

          TAG="v8.0.1-${GITHUB_RUN_NUMBER}"
          TITLE="Tasia Viewer 8.0.1.${GITHUB_RUN_NUMBER} Beta"
          PACKAGE="Tasia-Viewer-Windows-FMOD.zip"

          if [ ! -f "$PACKAGE" ]; then
            echo "::error::Windows viewer package not found: $PACKAGE"
            exit 1
          fi

          NOTES="$(mktemp)"

          cat > "$NOTES" <<EOF
          Tasia Viewer Windows beta build.

          Version: 8.0.1.${GITHUB_RUN_NUMBER}
          Commit: ${GITHUB_SHA::7}
          Channel: Tasia
          Platform: Windows x86_64
          FMOD: enabled
          KDU: removed

          This is a beta/pre-release build.
          Mom must test before stable release.
          EOF

          if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            gh release upload "$TAG" "$PACKAGE" \
              --repo "$GITHUB_REPOSITORY" \
              --clobber
          else
            gh release create "$TAG" "$PACKAGE" \
              --repo "$GITHUB_REPOSITORY" \
              --target "$GITHUB_SHA" \
              --title "$TITLE" \
              --notes-file "$NOTES" \
              --prerelease
          fi

      - name: Post to Discord
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.publish_release == 'true' }}
        shell: bash
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
        run: |
          set -euo pipefail

          if [ -z "${DISCORD_WEBHOOK_URL:-}" ]; then
            echo "::warning::DISCORD_WEBHOOK_URL secret is missing. Skipping Discord notification."
            exit 0
          fi

          python - "${GITHUB_REPOSITORY}" "${GITHUB_SHA}" "${GITHUB_RUN_NUMBER}" <<'PYEOF'
          import json
          import os
          import sys
          import urllib.request

          repo = sys.argv[1]
          sha = sys.argv[2][:7]
          run = sys.argv[3]

          version = f"8.0.1.{run}"
          tag = f"v8.0.1-{run}"
          release_url = f"https://github.com/{repo}/releases/tag/{tag}"

          payload = {
              "embeds": [
                  {
                      "title": f"Tasia Viewer {version} — Windows Beta",
                      "description": "Windows build ready!",
                      "url": release_url,
                      "color": 15105570,
                      "fields": [
                          {
                              "name": "Version",
                              "value": version,
                              "inline": True,
                          },
                          {
                              "name": "Platform",
                              "value": "Windows x86_64",
                              "inline": True,
                          },
                          {
                              "name": "Commit",
                              "value": sha,
                              "inline": True,
                          },
                      ],
                      "footer": {
                          "text": "💚 Tasia Release"
                      },
                  }
              ]
          }

          req = urllib.request.Request(
              os.environ["DISCORD_WEBHOOK_URL"],
              data=json.dumps(payload).encode("utf-8"),
              headers={"Content-Type": "application/json"},
              method="POST",
          )

          with urllib.request.urlopen(req) as response:
              response.read()
          PYEOF
