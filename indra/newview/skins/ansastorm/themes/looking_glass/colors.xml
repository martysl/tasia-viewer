<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<colors>
	<!--
	Looking Glass Theme
	Windows 7 Aero Glass inspired colors — opaque backgrounds for readability,
	glass borders and accents for the Aero feel.
	-->

	<!-- Text — full white for readability -->
	<color name="TextFgColor" reference="White" />
	<color name="TextFgReadOnlyColor" reference="LtGray_75" />
	<color name="TextFgTentativeColor" reference="LtGray_75" />
	<color name="TextBgFocusColor" value="0.10 0.13 0.18 1.0" />
	<color name="TextBgReadOnlyColor" value="0.12 0.15 0.20 1.0" />
	<color name="TextBgWriteableColor" value="0.10 0.13 0.18 1.0" />
	<color name="TextCursorColor" reference="White" />
	<color name="TextDefaultColor" value="0.35 0.65 0.90 1" />
	<color name="TextLinkColor" value="0.45 0.70 0.95 1" />

	<!-- Line editor — solid dark background for input fields -->
	<color name="LineEditorBgColor" value="0.08 0.10 0.14 1.0" />
	<color name="LineEditorFgColor" value="0.90 0.92 0.95 1" />

	<!-- Combo box — readable dropdowns -->
	<color name="ComboBoxBgColor" value="0.08 0.10 0.14 1.0" />
	<color name="ComboBoxFgColor" value="0.90 0.92 0.95 1" />
	<color name="ComboBoxListBgColor" value="0.10 0.13 0.18 1.0" />

