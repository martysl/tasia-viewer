	<color name="WindowBackgroundInactive" value="0.12 0.15 0.22 1.0" />
	<color name="WindowBackgroundActive" value="0.14 0.18 0.26 1.0" />
	<color name="WindowBackgroundOpaque" value="0.10 0.13 0.20 1.0" />

